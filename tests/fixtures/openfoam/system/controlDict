FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     twoPhaseSolver;

startFrom       latestTime; // startTime;

startTime       0.0; // 1.0e-5;

stopAt          endTime;

endTime         5.0e-4;

deltaT          5e-11;

writeInterval   5.0e-5;
